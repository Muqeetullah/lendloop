# Clerk development keys: obtain these from your Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Filled by `npx convex dev` when you select a development deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Configure CLERK_JWT_ISSUER_DOMAIN and ADMIN_CLERK_USER_ID in Convex,
# not as browser variables. See README.md.
